{
  "schema_version": 1,
  "canonical_branch": "main",
  "production_surfaces": {
    "backend": "backend",
    "frontend": "frontend"
  },
  "required_features": [
    {
      "id": "profile-performance-dashboard",
      "description": "Read-only Performance Profiles monitor in Shadow Portfolio",
      "files": [
        {
          "path": "backend/app/api/performance_rankings.py",
          "contains_all": [
            "/shadow-portfolio/profile-performance",
            "get_profile_performance"
          ]
        },
        {
          "path": "backend/app/services/profile_performance_service.py",
          "contains_all": [
            "get_profile_performance",
            "get_ranking_config",
            "score_metrics"
          ]
        },
        {
          "path": "frontend/app/dashboard/shadow-portfolio/page.tsx",
          "contains_all": [
            "profile-performance",
            "ProfilePerformanceDashboard"
          ]
        },
        {
          "path": "frontend/components/shadow-portfolio/ProfilePerformanceDashboard.tsx",
          "contains_all": [
            "Performance dos Profiles",
            "profilePerformance"
          ]
        }
      ]
    },
    {
      "id": "l3-entry-trigger-runtime-guard",
      "description": "Non-empty profile entry triggers cannot be erased by an empty global override",
      "files": [
        {
          "path": "backend/app/services/profile_runtime_config.py",
          "contains_all": [
            "merge_profile_runtime_block_config",
            "L3_CONFIG_GUARD"
          ]
        },
        {
          "path": "backend/app/tasks/pipeline_scan.py",
          "contains_all": [
            "merge_profile_runtime_block_config"
          ]
        },
        {
          "path": "backend/app/services/block_engine.py",
          "contains_all": [
            "_entry_trigger_identifier",
            "condition.get(\"indicator\")"
          ]
        },
        {
          "path": "backend/tests/test_profile_runtime_config.py",
          "contains_all": [
            "test_empty_global_entry_triggers_cannot_erase_profile_triggers",
            "test_uni_snapshot_is_blocked_after_safe_runtime_merge"
          ]
        },
        {
          "path": "backend/tests/test_shadow_watchlist_lineage.py",
          "contains_all": [
            "test_pipeline_scan_threads_rules_snapshot_to_all_l3_shadow_paths",
            "rules_snapshot=profile_config"
          ]
        }
      ]
    },
    {
      "id": "entry-risk-observational-only",
      "description": "Entry-risk candidate scores remain point-in-time observational fields with no execution or ML consumer",
      "files": [
        {
          "path": "backend/app/services/entry_risk_features.py",
          "contains_all": [
            "OBSERVATIONAL_ONLY_FIELDS",
            "assert_no_observational_execution_fields",
            "operational_effect\": False"
          ]
        },
        {
          "path": "backend/app/ml/feature_extractor.py",
          "contains_all": [
            "momentum_intensity_score",
            "exhaustion_risk_score",
            "FORBIDDEN_OPERATIONAL_PREFIXES"
          ]
        },
        {
          "path": "backend/tests/test_entry_risk_features.py",
          "contains_all": [
            "test_operational_config_cannot_be_enabled_in_v1",
            "test_candidate_scores_have_no_execution_consumers"
          ]
        }
      ]
    }
  ]
}
