{
  "$schema":"https://railway.com/railway.schema.json",
  "build":{"builder":"DOCKERFILE","dockerfilePath":"pump_ml/Dockerfile","watchPatterns":["pump_ml/**","backend/app/services/pump_opportunity_engine.py","backend/app/services/pump_contracts.py","backend/app/services/pump_ml_research.py"]},
