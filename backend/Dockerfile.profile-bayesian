# Dedicated scientific worker image. Do not use for API/trading services.
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-profile-bayesian.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements-profile-bayesian.txt

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    HOME=/home/appuser \
    XDG_CACHE_HOME=/home/appuser/.cache \
    MPLCONFIGDIR=/home/appuser/.cache/matplotlib \
    PROFILE_BAYESIAN_WORKER_QUEUES=profile_bayesian,profile_optimization \
    PROFILE_BAYESIAN_WORKER_CONCURRENCY=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ libpq-dev libgomp1 procps \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system appgroup \
    && adduser --system --home /home/appuser --ingroup appgroup appuser \
    && mkdir -p /home/appuser/.cache/matplotlib \
    && chown -R appuser:appgroup /home/appuser

COPY --from=builder /install /usr/local
COPY . .

RUN sed -i 's/\r$//' /app/start-profile-bayesian-worker.sh \
    && chown -R appuser:appgroup /app \
    && chmod +x /app/start-profile-bayesian-worker.sh

USER appuser

CMD ["/app/start-profile-bayesian-worker.sh"]
